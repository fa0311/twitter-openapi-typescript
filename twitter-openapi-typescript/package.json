{
  "name": "twitter-openapi-typescript",
  "version": "0.1.0",
  "description": "Implementation of Twitter internal API in TypeScript",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "twitter",
    "api",
    "typescript",
    "scraper"
  ],
  "author": "fa0311",
  "license": "custom license or AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/fa0311/twitter-openapi-typescript.git"
  },
  "main": "./dist/src/index.js",
  "typings": "./dist/src/index.d.ts",
  "dependencies": {
    "twitter-openapi-typescript-generated": "^0.1.0",
    "x-client-transaction-id-generater": "^0.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.0.0",
    "log4js": "^6.9.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
