{
  "compilerOptions": {
    "declaration": true,
    "target": "es2020",
    "module": "node16",
    "outDir": "dist",
    "lib": ["es2020", "dom"],
    "allowSyntheticDefaultImports": true,
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "include": ["src", "test"]
}
